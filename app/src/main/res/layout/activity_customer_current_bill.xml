<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FC">

    <!-- Top Bar -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1976D2"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Current Bill"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Bill"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Month: 2026-10"
                android:textSize="16sp"
                android:textColor="#555555"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Package: -"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDeliveryDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheduled Delivery Days: 0"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvDeliveredDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivered Days: 0"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Amount"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvPaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Status: Pending"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F57C00"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvBillStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bill Status: Generated"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnBillHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BILL HISTORY"
                android:layout_marginTop="28dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>