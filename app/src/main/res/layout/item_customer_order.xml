<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="14dp"

    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Order ID -->

        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order ID: #12345"
            android:textSize="13sp"
            android:textColor="#777777" />


        <!-- Water -->

        <TextView
            android:id="@+id/tvWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cold Water × 2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="6dp" />


        <!-- Total -->

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: ₹60"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="6dp" />


        <!-- Payment -->

        <TextView
            android:id="@+id/tvPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment: Cash"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />


        <!-- Order Type -->

        <TextView
            android:id="@+id/tvOrderType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Type: Single"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />


        <!-- Date -->

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 07 Sep 2026"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />


        <!-- Delivery Time -->

        <TextView
            android:id="@+id/tvDeliveryTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delivery Time: Anytime"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />


        <!-- Status -->

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="10dp" />


        <!-- Cancel -->

        <Button
            android:id="@+id/btnCancelOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL ORDER"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>